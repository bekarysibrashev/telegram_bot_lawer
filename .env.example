# ========================================
#   Qazaq Legal AI Bot — конфигурация
# ========================================

# 1. Токен Telegram бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=ваш_токен_здесь

# ========================================
# ВЫБЕРИТЕ ОДИН AI ПРОВАЙДЕР:
# ========================================

# --- ВАРИАНТ A: Groq API (рекомендуется, бесплатно) ---
# Зарегистрируйтесь на https://console.groq.com
# Создайте API ключ в разделе API Keys
AI_PROVIDER=groq
GROQ_API_KEY=ваш_groq_ключ_здесь
GROQ_MODEL=llama3-8b-8192

# --- ВАРИАНТ B: Ollama (локально, без интернета) ---
# Раскомментируйте эти строки и закомментируйте блок Groq выше
# AI_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
